# Tour admin (/admin). Copy to .env.local (or set in the host's environment) and fill in.
# Create the hash and the secret with: npm run admin:hash
ADMIN_USER=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Database: sqlite (a file on this server, the default), libsql (e.g. Turso) or postgres.
# On Vercel use libsql or postgres; a SQLite file would not survive a deploy.
DB_DRIVER=sqlite
DATABASE_URL=file:./data/musical-on-ice.db
# DATABASE_AUTH_TOKEN=          # libsql only

# On Vercel with Neon or Turso connected, their own variables are read when DATABASE_URL is empty
# (POSTGRES_URL / TURSO_DATABASE_URL + TURSO_AUTH_TOKEN): only DB_DRIVER is needed then.

# Media uploads. Own server: files go to UPLOADS_DIR. Vercel: connect a *public* Blob store,
# which adds BLOB_READ_WRITE_TOKEN.
# UPLOADS_DIR=./data/uploads
# BLOB_READ_WRITE_TOKEN=
# FFMPEG_PATH=                  # optional: another ffmpeg binary for video and audio

# Canonical site URL (optional; on Vercel the production domain is used)
# NEXT_PUBLIC_SITE_URL=https://example.com
